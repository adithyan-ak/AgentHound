FROM golang:1.25.13-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY demo/defcon/services/mcp-demo ./demo/defcon/services/mcp-demo
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /bin/agenthound-defcon-mcp ./demo/defcon/services/mcp-demo

FROM alpine:3.21
RUN apk add --no-cache ca-certificates && adduser -D -u 1001 demo
COPY --from=builder /bin/agenthound-defcon-mcp /usr/local/bin/agenthound-defcon-mcp
USER demo
ENTRYPOINT ["agenthound-defcon-mcp"]
